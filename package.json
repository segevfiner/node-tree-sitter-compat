{
  "name": "tree-sitter-compat",
  "version": "0.1.5",
  "description": "Compatibility module for old v8 API based language bindings for node-tree-sitter",
  "type": "commonjs",
  "types": "./index.d.ts",
  "main": "./index.js",
  "exports": {
    "types": "./index.d.ts",
    "default": "./index.js"
  },
  "scripts": {
    "install": "pkg-prebuilds-verify ./binding-options.js || node-gyp rebuild",
    "build": "node-gyp build",
    "rebuild": "node-gyp rebuild",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/segevfiner/node-tree-sitter-compat.git"
  },
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter"
  ],
  "author": "Segev Finer <segev208@gmail.com>",
  "license": "MIT",
  "node-gyp": true,
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.1",
    "pkg-prebuilds": "^1.1.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^20.19.43",
    "tree-sitter": "^0.21.1",
    "tree-sitter-c": "0.21.0",
    "tree-sitter-javascript": "0.20.4",
    "vitest": "^4.1.11"
  },
  "binary": {
    "napi_versions": [
      8
    ]
  },
  "files": [
    "binding.gyp",
    "binding-options.js",
    "binding-options.d.ts",
    "index.js",
    "index.d.ts",
    "src/**",
    "prebuilds"
  ]
}
